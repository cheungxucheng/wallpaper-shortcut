#include <windows.h>
#include "resource.h"

IDD_MONITOR_DIALOG DIALOGEX 0, 0, 220, 140
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose Monitor"
FONT 9, "Segoe UI"

BEGIN
    LISTBOX IDC_MONITOR_LIST, 10, 10, 200, 90,
            LBS_NOTIFY | WS_BORDER | WS_VSCROLL

    DEFPUSHBUTTON "Open", IDOK, 55, 110, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 115, 110, 50, 14
END